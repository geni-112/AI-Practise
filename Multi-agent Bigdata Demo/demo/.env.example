# Optional Huawei MaaS configuration.
# Do not commit real keys. Set these in your shell or a local secret manager.
# HUAWEI_MAAS_API_KEY is required for real MaaS calls.
# Base URL and model can be omitted to use these defaults.
HUAWEI_MAAS_BASE_URL=https://api-ap-southeast-1.modelarts-maas.com/openai/v1
HUAWEI_MAAS_MODEL=glm-5.2
HUAWEI_MAAS_API_KEY=

# Optional Huawei Cloud existing-resource read-only validation.
# Keep real credential values in your shell, Windows user environment, ignored
# .env.local, or a cloud secret manager. Do not read or store credentials in
# skill files, chat messages, screenshots, cookies, saved passwords, or logs.
HUAWEICLOUD_ENABLE_READONLY_PROBE=false
HUAWEICLOUD_REGION=la-south-2
HUAWEICLOUD_PROJECT_ID=
HUAWEICLOUD_ACCESS_KEY=
HUAWEICLOUD_SECRET_KEY=

# Optional real Huawei Cloud execution-layer variables.
# Do not commit real values. Prefer:
# .\cloud_real_bigdata\scripts\18_bootstrap_operator_session.ps1 -ConfigureCredentials -PersistUserEnv -SetGuardDefaults -DetectAdminCidr -EnableWebEcs -RunTerraformPreflight
# Review the no-create resource plan at any time:
# .\cloud_real_bigdata\scripts\21_export_minimal_cost_quota_plan.ps1 -EnableWebEcs
# Then, only after readiness is ready:
# .\cloud_real_bigdata\scripts\19_run_customer_demo_once.ps1 -EnableWebEcs -SshKeyPath "<path-to-private-key.pem>" -Apply -ConfirmPaidResources
# After a successful strict audit, the handoff package is exported automatically.
# To regenerate it:
# .\cloud_real_bigdata\scripts\20_export_customer_handoff.ps1 -BaseUrl "http://<customer-demo-url>" -RequireCloudSuccess -PublishToEvidence
# or the lower-level:
# .\cloud_real_bigdata\scripts\12_configure_cloud_credentials.ps1 -PersistUserEnv
TF_VAR_mrs_manager_admin_password=
TF_VAR_node_key_pair_name=
# Required before customer/commercial apply. Use a trusted office/VPN CIDR,
# for example x.x.x.x/32. Open ingress is blocked unless explicitly overridden
# with -AllowOpenIngressForDemo for a disposable demo.
TF_VAR_admin_cidr=
TF_VAR_obs_bucket_name=
TF_VAR_demo_owner=
TF_VAR_demo_purpose=sat-agentic-customer-demo
TF_VAR_demo_domain=
# UTC timestamp. Keep the first demo short-lived, for example 2026-07-10T18:00:00Z.
TF_VAR_demo_expires_at=

# Optional non-secret minimal sizing overrides read by the no-create resource plan.
# Leave empty for Terraform defaults.
TF_VAR_mrs_master_flavor=
TF_VAR_mrs_core_flavor=
TF_VAR_mrs_master_node_count=
TF_VAR_mrs_core_node_count=
TF_VAR_mrs_root_volume_size=
TF_VAR_mrs_data_volume_size=
TF_VAR_web_flavor_id=
TF_VAR_web_image_name=
TF_VAR_web_bandwidth_size=

# DWS is optional and disabled unless you pass -EnableDws.
TF_VAR_dws_admin_password=
TF_VAR_dws_node_type=
TF_VAR_dws_node_count=
TF_VAR_dws_cn_count=
TF_VAR_dws_volume_capacity=

# DataArts is optional and disabled unless you pass -EnableDataArts.
# Terraform models this as prepaid, so confirm quota and price before enabling.
TF_VAR_dataarts_version=
TF_VAR_dataarts_period_unit=
TF_VAR_dataarts_period=
# Production control plane. Keep disabled for local generation-only use.
SAT_PRODUCTION_MODE=false
SAT_AUTH_MODE=disabled
SAT_DATABASE_URL=sqlite:///runtime/sat-control.db
SAT_CLOUD_EXECUTION_ENABLED=false
SAT_REQUIRE_REAL_CLOUD_PROBE=true
SAT_ALLOWED_EXECUTION_TARGETS=mrs,dataarts
SAT_REQUIRE_EXECUTION_PROFILE=true
SAT_EXECUTION_PROFILES_JSON=[]

# JWT mode. Configure either a JWKS URL or a public verification key.
SAT_JWT_ALGORITHM=RS256
SAT_JWT_ISSUER=
SAT_JWT_AUDIENCE=
SAT_JWT_JWKS_URL=
SAT_JWT_PUBLIC_KEY=
SAT_JWT_ROLE_CLAIM=roles

# trusted_header mode. The reverse proxy must remove client-supplied copies
# and inject authenticated values itself.
SAT_TRUSTED_USER_HEADER=X-SAT-User
SAT_TRUSTED_ROLES_HEADER=X-SAT-Roles

# Protected worker allowlists. Values are non-secret resource identifiers.
SAT_ALLOWED_MRS_CLUSTER_IDS=
SAT_ALLOWED_DATAARTS_WORKSPACE_IDS=
SAT_ALLOWED_DATAARTS_JOB_NAMES=
SAT_ALLOWED_OBS_PREFIXES=
SAT_EXECUTION_POLL_SECONDS=10
SAT_EXECUTION_TIMEOUT_SECONDS=3600
