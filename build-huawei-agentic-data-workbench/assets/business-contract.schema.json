{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/agentic-data-business-contract.schema.json",
  "title": "Agentic Data Workbench Business Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "template_id",
    "business_goal",
    "data_sources",
    "grain",
    "dimensions",
    "metrics",
    "filters",
    "privacy",
    "masking_rules",
    "quality_rules",
    "security_rules",
    "approval_policy",
    "output_artifacts",
    "acceptance",
    "assumptions"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "template_id": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "business_goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "owner", "business_domain"],
      "properties": {
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "owner": {"type": "string", "minLength": 1, "maxLength": 256},
        "business_domain": {"type": "string", "minLength": 1, "maxLength": 128},
        "decision_supported": {"type": "string", "maxLength": 1000}
      }
    },
    "data_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "location", "format", "classification"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 256},
          "location": {"type": "string", "minLength": 1, "maxLength": 2048},
          "format": {"type": "string", "minLength": 1, "maxLength": 64},
          "classification": {
            "type": "string",
            "enum": ["public", "internal", "confidential", "restricted"]
          },
          "required_columns": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "snapshot": {"type": ["string", "null"], "maxLength": 256}
        }
      }
    },
    "grain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "keys"],
      "properties": {
        "description": {"type": "string", "minLength": 1, "maxLength": 1000},
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "dimensions": {
      "type": "array",
      "items": {"$ref": "#/$defs/namedExpression"},
      "uniqueItems": true
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "expression", "aggregation"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 256},
          "expression": {"type": "string", "minLength": 1, "maxLength": 4000},
          "description": {"type": "string", "maxLength": 1000},
          "aggregation": {"type": "string", "maxLength": 128},
          "unit": {"type": ["string", "null"], "maxLength": 64},
          "tolerance": {"type": "number", "minimum": 0}
        }
      }
    },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "operator", "value"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "operator": {
            "type": "string",
            "enum": ["eq", "ne", "in", "not_in", "gt", "gte", "lt", "lte", "between", "is_null", "not_null"]
          },
          "value": {}
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct_identifiers", "model_context_policy", "retention"],
      "properties": {
        "direct_identifiers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "model_context_policy": {
          "type": "string",
          "enum": ["metadata_only", "masked_samples", "approved_payload"]
        },
        "retention": {"type": "string", "minLength": 1, "maxLength": 256},
        "allow_prompt_retention": {"type": "boolean", "default": false}
      }
    },
    "masking_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "method", "output_field"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "method": {
            "type": "string",
            "enum": ["drop", "hash", "partial_mask", "tokenize", "redact", "generalize"]
          },
          "output_field": {"type": ["string", "null"]},
          "parameters": {"type": "object"}
        }
      }
    },
    "quality_rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rule"}
    },
    "security_rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rule"}
    },
    "approval_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_artifacts", "production_execution_blocked", "required_roles"],
      "properties": {
        "required_artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["business_contract", "pyspark", "sql", "dag", "quality", "security", "lineage"]
          },
          "uniqueItems": true
        },
        "production_execution_blocked": {"type": "boolean", "const": true},
        "required_roles": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "output_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rule"}
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "target_services": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["local", "OBS", "MRS", "DataArts", "DWS", "MaaS"]
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "namedExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "expression"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "expression": {"type": "string", "minLength": 1, "maxLength": 4000},
        "description": {"type": "string", "maxLength": 1000}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "severity", "check"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "description": {"type": "string", "minLength": 1, "maxLength": 1000},
        "severity": {"type": "string", "enum": ["info", "warning", "blocking"]},
        "check": {"type": "string", "minLength": 1, "maxLength": 4000},
        "threshold": {}
      }
    }
  }
}
