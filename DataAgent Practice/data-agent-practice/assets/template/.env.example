# Local demo only. Never store actual values in source control.
DEMO_MODE=true
DATA_BACKEND=sqlite
NEXO_BROWSER_ONLY=true
NEXO_API_TARGET=http://127.0.0.1:8000

# Default AI provider; supply this environment's own endpoint and credentials.
MODEL_PROVIDER=huawei_maas
MODEL_NAME=glm-5.3
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_TIMEOUT=90
# For another approved OpenAI-compatible endpoint, set MODEL_PROVIDER=openai_compatible.
# No automatic provider fallback is performed.

OPENMETADATA_URL=http://127.0.0.1:8585
OPENMETADATA_TOKEN=
TEMPORAL_ENABLED=true
TEMPORAL_ADDRESS=127.0.0.1:7233
OPA_URL=

# Production identity adapter: signed OIDC token claims nexo_tenant and nexo_role.
# Setting DEMO_MODE=false disables the identity-switch endpoint.
OIDC_ISSUER=
OIDC_AUDIENCE=nexo-api
OIDC_JWKS_URL=

# Cloud provisioning credentials are injected securely into the process environment.
HUAWEICLOUD_REGION=la-north-2
HUAWEICLOUD_PROJECT_ID=
HUAWEICLOUD_SDK_AK=
HUAWEICLOUD_SDK_SK=
HUAWEICLOUD_SDK_SECURITY_TOKEN=

# DWS query account should be restricted to the required synthetic data views.
DWS_HOST=
DWS_PORT=8000
DWS_DATABASE=gaussdb
DWS_USER=
DWS_PASSWORD=
DWS_SSLMODE=verify-full
DWS_SSLROOTCERT=

# Only for a cloud demo exposed through HTTPS. Generated by huawei_host.py.
# The first owner chooses their password through the one-use invite; it is never a cloud password.
DEPLOYMENT_KIND=local
NEXO_GATE_SECRET=
NEXO_INVITE_SHA256=
NEXO_INVITE_EXPIRES=
