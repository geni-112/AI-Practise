# Store the real file outside the repository, for example at
# /etc/bigdata-monitor/huawei.env with mode 0600.
HUAWEICLOUD_ACCESS_KEY=set-at-runtime
HUAWEICLOUD_SECRET_KEY=set-at-runtime
HUAWEICLOUD_REGION=your-region-id
HUAWEICLOUD_PROJECT_ID=your-project-id
MRS_CLUSTER_ID=your-mrs-cluster-id
MRS_CLUSTER_NAME=your-mrs-cluster-name
