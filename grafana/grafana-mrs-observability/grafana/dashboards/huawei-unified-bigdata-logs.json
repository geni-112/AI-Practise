  "templating": {
    "list": [
      {
        "name": "job",
        "label": "DataArts job",
        "type": "query",
        "datasource": {"type": "loki", "uid": "huawei-loki"},
        "query": "label_values({source=\"dataarts\",ingestion_version=\"2\"}, job_name)",
        "definition": "label_values({source=\"dataarts\",ingestion_version=\"2\"}, job_name)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1
      },
      {
        "name": "status",
        "label": "DataArts status",
        "type": "query",
        "datasource": {"type": "loki", "uid": "huawei-loki"},
        "query": "label_values({source=\"dataarts\",ingestion_version=\"2\"}, status)",
        "definition": "label_values({source=\"dataarts\",ingestion_version=\"2\"}, status)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1
      },
      {
        "name": "node",
        "label": "DataArts node",
        "type": "query",
        "datasource": {"type": "loki", "uid": "huawei-loki"},
        "query": "label_values({source=\"dataarts\",ingestion_version=\"2\"}, node_name)",
        "definition": "label_values({source=\"dataarts\",ingestion_version=\"2\"}, node_name)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1
      },
      {
        "name": "search",
        "label": "Text contains",
        "type": "textbox",
        "query": "",
        "current": {"selected": true, "text": "", "value": ""}
      },
      {
        "name": "mrs_job",
        "label": "MRS job",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "huawei-prometheus"},
        "query": {
          "query": "label_values(huawei_mrs_job_execution_info, job_name)",
          "refId": "mrs-job-var"
        },
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1
      },
      {
        "name": "mrs_result",
        "label": "MRS result",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "huawei-prometheus"},
        "query": {
          "query": "label_values(huawei_mrs_job_execution_info, job_result)",
          "refId": "mrs-result-var"
        },
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1
      }
    ]
  },
