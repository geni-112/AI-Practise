      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {"type": "auto"},
            "filterable": true,
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "Parameters"},
            "properties": [{"id": "custom.width", "value": 520}]
          },
          {
            "matcher": {"id": "byName", "options": "Log root"},
            "properties": [{"id": "custom.width", "value": 420}]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "enablePagination": true,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true
      },
      "transformations": [
        {"id": "labelsToFields", "options": {"mode": "columns"}},
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {
              "job_name": 0,
              "job_type": 1,
              "status": 2,
              "owner": 3,
              "created_by": 4,
              "parameters": 5,
              "log_root": 6
            },
            "renameByName": {
              "created_by": "Created by",
              "job_name": "Job",
              "job_type": "Type",
              "log_root": "Log root",
              "owner": "Owner",
              "parameters": "Parameters",
              "status": "Status"
            }
          }
        }
      ]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 40,
  "tags": [
    "huawei-cloud",
    "dataarts",
    "mrs",
    "logs",
    "loki",
    "databricks-inspired"
